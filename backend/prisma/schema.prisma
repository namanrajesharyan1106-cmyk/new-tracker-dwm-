generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(uuid())
  employeeId          String         @unique
  name                String
  email               String         @unique
  mobile              String?
  password            String
  role                String         @default("TEAM_MEMBER") // SUPER_ADMIN, DEPARTMENT_ADMIN, TEAM_MEMBER
  designation         String?
  isApproved          Boolean        @default(false)
  isActive            Boolean        @default(true)
  
  // Auth Fields
  refreshToken        String?
  verificationToken   String?
  resetPasswordToken  String?
  resetPasswordExpire DateTime?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  teams               UserTeamMapping[]
  sections            UserSectionMapping[]

  assignedTasks       Task[]               @relation("AssignedToUser")
  taskAssignments     UserTaskMapping[]    @relation("UserTaskAssignments")
  createdTasks        Task[]               @relation("CreatedByUser")

  dailyPlans          DailyPlan[]
  dailyClosings       DailyClosing[]
  attendance          Attendance[]
  workLogs            TaskWorkLog[]
  taskVerifications   TaskVerificationHistory[]
  authoredMeetingNotes DailyMeetingNote[]   @relation("MeetingNoteAuthor")
  planApprovals       DailyPlanApprovalHistory[]
  closingReviews      DailyClosingReviewHistory[]
  notifications       Notification[]
  auditLogs           AuditLog[]
}

model Section {
  id              String         @id @default(uuid())
  name            String         @unique
  description     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  teams           Team[]
  users           UserSectionMapping[]
  projects        Project[]
  activities      Activity[]
  tasks           Task[]
  meetingNotes    DailyMeetingNote[]
}

model Team {
  id              String               @id @default(uuid())
  name            String
  description     String?
  sectionId       String
  section         Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  users           UserTeamMapping[]
  projects        ProjectTeamMapping[]
  activities      Activity[]
  tasks           Task[]
  meetingNotes    DailyMeetingNote[]

  @@unique([name, sectionId])
}

model UserTeamMapping {
  userId          String
  teamId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  team            Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
}

model UserSectionMapping {
  userId          String
  sectionId       String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  section         Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([userId, sectionId])
}

model Requirement {
  id                 String       @id @default(uuid())
  title              String
  description        String?
  sponsor            String?
  manager            String?
  department         String?
  timeline           String?
  budget             Float?
  progress           Int          @default(0)
  status             String       @default("APPROVED") // PENDING, APPROVED, PUBLISHED
  priority           String?      @default("HIGH")
  executionStatus    String?      @default("Not Started") // Not Started, Execution Started, In Progress, Delayed, Completed, Verified, Closed
  assignedTeams      String?      // JSON array of assigned team names/ids
  assignedMembers    String?      // JSON array of assigned member names/ids
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  
  tasks              Task[]
  activities         Activity[]
  dailyPlans         DailyPlan[]  @relation("DailyPlanRequirements")
}

model Project {
  id              String               @id @default(uuid())
  name            String
  description     String?
  drsRequestId    String?              @unique
  plant           String?
  priority        String               @default("MEDIUM")
  status          String?
  startDate       DateTime?
  targetDate      DateTime?
  progress        Int                  @default(0)
  plannedProgress Int                  @default(0)
  variance        Float                @default(0)
  expectedFinish  DateTime?
  riskLevel       String               @default("LOW")
  health          String               @default("ON_TRACK")
  sponsor         String?
  manager         String?
  budget          Float?
  customer        String?
  sectionId       String?
  section         Section?             @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  teams           ProjectTeamMapping[]
  activities      Activity[]
  tasks           Task[]
  dailyPlans      DailyPlan[]          @relation("DailyPlanProjects")
}

model ProjectTeamMapping {
  projectId       String
  teamId          String
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team            Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([projectId, teamId])
}

model Activity {
  id              String               @id @default(uuid())
  name            String
  description     String?
  requirementId   String?
  requirement     Requirement?         @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sectionId       String?
  section         Section?             @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  teamId          String?
  team            Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)

  startDate       DateTime?
  targetDate      DateTime?
  priority        String               @default("MEDIUM")
  status          String               @default("NOT_STARTED")
  estimatedHours  Float?
  actualHours     Float?
  progress        Int                  @default(0)
  remarks         String?

  tasks           Task[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Task {
  id                 String       @id @default(uuid())
  title              String
  description        String?
  priority           String       @default("MEDIUM")
  type               String       @default("TASK")
  stageName          String?      @default("Discovery")

  requirementId      String?
  requirement        Requirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  projectId          String?
  project            Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  activityId         String?
  activity           Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)

  sectionId          String?
  section            Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  
  teamId             String?
  team               Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  assignedToId       String?
  assignedTo         User?        @relation("AssignedToUser", fields: [assignedToId], references: [id])
  
  assignedUsers      UserTaskMapping[]

  createdById        String
  createdBy          User         @relation("CreatedByUser", fields: [createdById], references: [id])

  parentTaskId       String?
  parentTask         Task?        @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks           Task[]       @relation("SubTasks")

  status             String       @default("NOT_STARTED")
  progress           Int          @default(0)
  startDate          DateTime?
  targetDate         DateTime?
  dueDate            DateTime?
  completionDate     DateTime?
  
  estimatedHours     Float?
  actualHours        Float?

  isRecurring        Boolean      @default(false)
  recurrenceInterval String?
  delayReason        String?
  blockReason        String?

  carryForwardCount  Int          @default(0)
  carryForwardReason String?
  originalDate       DateTime?

  tags               String?
  attachmentUrl      String?
  closingStatusText  String?

  dependencies       Task[]  @relation("TaskDependencies")
  dependentTasks     Task[]  @relation("TaskDependencies")

  delayHistory       TaskDelayHistory[]
  blockHistory       TaskBlockHistory[]
  workLogs           TaskWorkLog[]
  verificationHistory TaskVerificationHistory[]
  comments           TaskComment[]
  dailyPlans         DailyPlan[]  @relation("DailyPlanTasks")

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model UserTaskMapping {
  taskId             String
  userId             String
  task               Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user               User         @relation("UserTaskAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model TaskWorkLog {
  id                 String       @id @default(uuid())
  taskId             String
  task               Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime     @default(now())
  hoursWorked        Float
  workSummary        String
  remarks            String?
  createdAt          DateTime     @default(now())
}

model TaskVerificationHistory {
  id                 String       @id @default(uuid())
  taskId             String
  task               Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  verifierId         String
  verifier           User         @relation(fields: [verifierId], references: [id], onDelete: Cascade)
  action             String       // VERIFIED, REJECTED, CLOSED
  comments           String?
  createdAt          DateTime     @default(now())
}

model TaskTemplate {
  id                 String       @id @default(uuid())
  name               String       @unique
  description        String?
  category           String?      // e.g. DIGITALIZATION, SOFTWARE, MAINTENANCE
  structure          String       // JSON string representing activities & tasks
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model TaskComment {
  id                 String       @id @default(uuid())
  taskId             String
  task               Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId             String
  comment            String
  createdAt          DateTime     @default(now())
}

model TaskDelayHistory {
  id                   String     @id @default(uuid())
  taskId               String
  task                 Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  reason               String
  customReason         String?
  expectedCompletion   DateTime
  estimatedDelayDays   Int
  comments             String?

  isApproved           Boolean    @default(false)
  
  createdAt            DateTime   @default(now())
}

model TaskBlockHistory {
  id                   String     @id @default(uuid())
  taskId               String
  task                 Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  reason               String
  blockedSince         DateTime   @default(now())
  expectedResolution   DateTime?
  
  createdAt            DateTime   @default(now())
}

model DailyPlan {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime    @default(now())
  planText        String
  
  topPriorities   String?
  top3TaskIds     String?
  expectedHours   Float?
  strategy        String?
  remarks         String?
  supportRequired String?
  isSubmitted     Boolean     @default(true)

  approvalStatus  String      @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, UNLOCKED
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  isLocked        Boolean     @default(false)

  approvalHistory DailyPlanApprovalHistory[]

  requirements    Requirement[]@relation("DailyPlanRequirements")
  projects        Project[]   @relation("DailyPlanProjects")
  tasks           Task[]      @relation("DailyPlanTasks")
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([userId, date])
}

model DailyPlanApprovalHistory {
  id              String      @id @default(uuid())
  dailyPlanId     String
  dailyPlan       DailyPlan   @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  approverId      String
  approver        User        @relation(fields: [approverId], references: [id], onDelete: Cascade)
  action          String      // APPROVED, REJECTED, UNLOCKED
  comments        String?
  createdAt       DateTime    @default(now())
}

model DailyMeetingNote {
  id                  String      @id @default(uuid())
  sectionId           String?
  section             Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  teamId              String?
  team                Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  date                DateTime    @default(now())
  
  todayFocus          String
  customerVisit       String?
  machineBreakdown    String?
  safetyAlert         String?
  priorityProjects    String?
  specialInstructions String?
  actionItems         String?
  attachmentUrl       String?

  createdById         String
  createdBy           User        @relation("MeetingNoteAuthor", fields: [createdById], references: [id])
  
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model DailyClosing {
  id                  String      @id @default(uuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                DateTime    @default(now())
  closingText         String
  
  completedTaskIds    String?
  pendingTaskIds      String?
  delayedTaskIds      String?
  blockedTaskIds      String?
  actualHoursWorked   Float?
  achievements        String?
  problemsFaced       String?
  tomorrowPriority    String?
  supportRequired     String?
  productivityScore   Float?
  isSubmitted         Boolean     @default(true)

  reviewStatus        String      @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, NEEDS_DISCUSSION, REQUIRES_SUPPORT, CARRY_FORWARD_REQUIRED
  reviewerId          String?
  reviewedAt          DateTime?
  managerRemarks      String?

  reviewHistory       DailyClosingReviewHistory[]

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([userId, date])
}

model DailyClosingReviewHistory {
  id                  String        @id @default(uuid())
  dailyClosingId      String
  dailyClosing        DailyClosing  @relation(fields: [dailyClosingId], references: [id], onDelete: Cascade)
  reviewerId          String
  reviewer            User          @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  status              String        // APPROVED, NEEDS_DISCUSSION, REQUIRES_SUPPORT, CARRY_FORWARD_REQUIRED
  remarks             String?
  createdAt           DateTime      @default(now())
}

model Attendance {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime         @default(now())
  status          String           @default("PRESENT") // PRESENT, ABSENT, LEAVE, WFH, HALF_DAY
  remarks         String?
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, date])
}

model Notification {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  message         String
  entityType      String?
  entityId        String?
  isRead          Boolean     @default(false)
  
  createdAt       DateTime    @default(now())
}

model AuditLog {
  id              String      @id @default(uuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action          String
  entity          String
  entityId        String
  details         String? // Storing JSON as string for SQLite compatibility
  
  createdAt       DateTime    @default(now())
}
